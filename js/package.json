{
  "name": "validonce",
  "version": "0.3.3",
  "description": "Validate once, enforce everywhere: shared validation rules.",
  "license": "Apache-2.0",
  "author": "Metatoy LLC",
  "repository": "github:metatoy/validonce",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js"
    },
    "./server-errors": {
      "types": "./dist/server-errors.d.ts",
      "import": "./dist/server-errors.js"
    },
    "./messages": {
      "types": "./dist/messages.d.ts",
      "import": "./dist/messages.js"
    },
    "./deps": {
      "types": "./dist/deps.d.ts",
      "import": "./dist/deps.js"
    },
    "./react-hook-form": {
      "types": "./dist/react-hook-form.d.ts",
      "import": "./dist/react-hook-form.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts src/zod.ts src/openapi.ts src/server-errors.ts src/messages.ts src/deps.ts src/react-hook-form.ts src/angular.ts src/vue.ts --bundle --splitting --format=esm --platform=neutral --target=es2022 --external:zod --external:react-hook-form --external:react --external:vue --external:@angular/core --external:@angular/forms --outdir=dist && esbuild src/cli.ts --bundle --format=esm --platform=node --target=node20 --external:zod --outfile=dist/cli.js \"--banner:js=#!/usr/bin/env node\" && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@biomejs/biome": "2.6.8",
    "@hookform/resolvers": "7.0.8",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-hook-form": "7.92.0",
    "rxjs": "7.8.2",
    "typescript": "7.0.2",
    "vee-validate": "4.15.1",
    "vitest": "5.1.1",
    "vue": "3.5.46",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@angular/core": ">=21.0.0",
    "@angular/forms": ">=21.0.0",
    "react-hook-form": "^7.55.0",
    "zod": "^4.0.0",
    "vue": "^3.5.0",
    "vee-validate": "^4.12.0 || ^5.0.0-beta.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vee-validate": {
      "optional": true
    }
  },
  "bin": {
    "validonce": "./dist/cli.js"
  },
  "homepage": "https://github.com/metatoy/validonce#readme",
  "bugs": {
    "url": "https://github.com/metatoy/validonce/issues"
  },
  "keywords": [
    "validation",
    "zod",
    "forms",
    "react-hook-form",
    "angular",
    "vue",
    "openapi",
    "fluentvalidation",
    "pydantic"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
