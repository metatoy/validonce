{
  "name": "validonce",
  "version": "0.0.0",
  "private": true,
  "description": "Validate once, enforce everywhere: shared validation rules.",
  "license": "Apache-2.0",
  "author": "Metatoy LLC",
  "repository": "github:metatoy/validonce",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js"
    },
    "./server-errors": {
      "types": "./dist/server-errors.d.ts",
      "import": "./dist/server-errors.js"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts src/zod.ts src/openapi.ts src/server-errors.ts --bundle --splitting --format=esm --platform=neutral --target=es2022 --external:zod --outdir=dist && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@hookform/resolvers": "7.0.8",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-hook-form": "7.92.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
