{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": { "name": "contacts.example.test" },
  "spec": {
    "group": "example.test",
    "scope": "Namespaced",
    "names": { "plural": "contacts", "singular": "contact", "kind": "Contact", "listKind": "ContactList" },
    "versions": [
      {
        "name": "v1",
        "served": true,
        "storage": true,
        "schema": {
          "openAPIV3Schema": {
            "type": "object",
            "required": ["country"],
            "properties": {
              "email": { "type": "string", "minLength": 1, "nullable": true },
              "phone": { "type": "string", "minLength": 1, "pattern": "^\\+?[0-9 ()-]{7,20}$", "nullable": true },
              "street": { "type": "string", "minLength": 1, "nullable": true },
              "city": { "type": "string", "minLength": 1, "nullable": true },
              "postalCode": { "type": "string", "minLength": 1, "nullable": true },
              "country": { "type": "string", "enum": ["US", "CA", "GB", "other"] },
              "availableFrom": { "type": "string", "format": "date", "nullable": true },
              "availableTo": { "type": "string", "format": "date", "nullable": true }
            },
            "x-kubernetes-validations": [
              {
                "rule": "has(self.email) || has(self.phone)",
                "message": "Enter an email or a phone number",
                "fieldPath": ".email"
              },
              {
                "rule": "(has(self.street) && has(self.city) && has(self.postalCode)) || (!has(self.street) && !has(self.city) && !has(self.postalCode))",
                "message": "Fill in street, city and postal code together",
                "fieldPath": ".street"
              },
              {
                "rule": "self.country != 'US' || has(self.postalCode)",
                "message": "Postal code is required in the US",
                "fieldPath": ".postalCode"
              },
              {
                "rule": "!has(self.availableFrom) || !has(self.availableTo) || self.availableTo >= self.availableFrom",
                "message": "Available to must be on or after available from",
                "fieldPath": ".availableTo"
              }
            ]
          }
        }
      }
    ]
  }
}
