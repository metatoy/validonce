{
  "name": "validonce-example-nestjs-app",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Metatoy LLC",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts src/export-openapi.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outdir=dist",
    "typecheck": "tsc --noEmit",
    "start": "pnpm build && node dist/main.js",
    "export-openapi": "pnpm build && node dist/export-openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/swagger": "12.1.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "validonce": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
