{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "signups.example.test"
  },
  "spec": {
    "group": "example.test",
    "scope": "Namespaced",
    "names": {
      "plural": "signups",
      "singular": "signup",
      "kind": "Signup",
      "listKind": "SignupList"
    },
    "versions": [
      {
        "name": "v1",
        "served": true,
        "storage": true,
        "schema": {
          "openAPIV3Schema": {
            "type": "object",
            "properties": {
              "spec": {
                "type": "object",
                "required": [
                  "plan"
                ],
                "properties": {
                  "plan": {
                    "type": "string",
                    "enum": [
                      "free",
                      "pro"
                    ]
                  },
                  "company": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "start": {
                    "type": "string",
                    "format": "date"
                  },
                  "end": {
                    "type": "string",
                    "format": "date"
                  },
                  "minReplicas": {
                    "type": "integer"
                  },
                  "maxReplicas": {
                    "type": "integer"
                  }
                },
                "x-kubernetes-validations": [
                  {
                    "rule": "self.plan != 'pro' || has(self.company)",
                    "message": "Company is required on the Pro plan",
                    "fieldPath": ".company"
                  },
                  {
                    "rule": "!has(self.start) || !has(self.end) || self.end >= self.start",
                    "message": "End date must be on or after the start date",
                    "fieldPath": ".end"
                  },
                  {
                    "rule": "!has(self.minReplicas) || !has(self.maxReplicas) || self.maxReplicas >= self.minReplicas",
                    "message": "Max replicas must be at least the min replicas",
                    "fieldPath": ".maxReplicas"
                  },
                  {
                    "rule": "has(self.email) || has(self.phone)",
                    "message": "Give an email or a phone number",
                    "fieldPath": ".email"
                  },
                  {
                    "rule": "!has(self.company) || self.company.size() <= 40",
                    "message": "Company must be 40 characters or fewer",
                    "fieldPath": ".company"
                  }
                ]
              }
            }
          }
        }
      }
    ]
  }
}
