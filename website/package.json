{
  "name": "validonce-website",
  "version": "0.0.0",
  "private": true,
  "description": "The validonce documentation site (validonce.metatoy.com). Not published.",
  "license": "Apache-2.0",
  "author": "Metatoy LLC",
  "scripts": {
    "prepare:site": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prepare.mjs",
    "start": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prepare.mjs && docusaurus start",
    "build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prepare.mjs && docusaurus build",
    "serve": "docusaurus serve",
    "typecheck": "tsc --noEmit",
    "check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "validonce": "workspace:*"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
