{
  "version": 1,
  "suite": "edge",
  "description": "Edge cases across the pinned behaviors (found by cross-checking the three evaluators, results checked by hand against the spec).",
  "cases": [
    {
      "id": "edge-001",
      "description": "year<100 datetime",
      "rules": [
        {
          "id": "Edge.compare.001",
          "kind": "compare",
          "left": {
            "field": "e"
          },
          "op": "gt",
          "right": {
            "field": "s"
          },
          "type": "datetime",
          "message": {
            "key": "rules.edge"
          }
        }
      ],
      "data": {
        "s": "0051-01-01T00:00:00Z",
        "e": "0050-12-31T23:59:59Z"
      },
      "expect": [
        {
          "path": [
            "e"
          ],
          "ruleId": "Edge.compare.001",
          "key": "rules.edge",
          "params": {}
        }
      ]
    },
