          "id": "Contact.at_least_one_of.email",
          "kind": "at_least_one_of",
          "fields": [
            "email",
            "phone"
          ],
          "message": {
            "key": "rules.contact_required"
          }
        },
        {
          "id": "Payment.exactly_one_of.card",
          "kind": "exactly_one_of",
          "fields": [
            "card",
            "invoice"
          ],
          "message": {
            "key": "rules.one_payment"
          }
        }
