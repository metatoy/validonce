{
  "openapi": "3.0.0",
  "paths": {
    "/signups": {
      "post": {
        "operationId": "SignupsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Signup"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": [
          "Signups"
        ]
      }
    }
  },
  "info": {
    "title": "validonce NestJS example",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "Signup": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "string",
            "enum": [
              "free",
              "pro"
            ]
          },
          "company": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "string",
            "format": "date"
          },
          "end": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "quantity": {
            "type": "number",
            "format": "int32"
          }
        },
        "required": [
          "plan",
          "email",
          "start",
          "quantity"
        ],
        "x-validonce": {
          "version": 1,
          "rules": [
            {
              "id": "Signup.required_when.company",
              "kind": "required_when",
              "field": "company",
              "when": {
                "eq": {
                  "field": "plan",
                  "value": "pro"
                }
              },
              "message": {
                "key": "rules.company_required"
              }
            },
            {
              "id": "Signup.compare.end",
              "kind": "compare",
              "left": {
                "field": "end"
              },
              "op": "ge",
              "right": {
                "field": "start"
              },
              "type": "date",
              "message": {
                "key": "rules.end_after_start"
              }
            },
            {
              "id": "Signup.compare.quantity",
              "kind": "compare",
              "left": {
                "field": "quantity"
              },
              "op": "ge",
              "right": {
                "value": 1
              },
              "type": "number",
              "message": {
                "key": "rules.quantity_min",
                "params": {
                  "min": 1
                }
              }
            }
          ]
        }
      }
    }
  }
}
