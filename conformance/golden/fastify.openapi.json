{
  "openapi": "3.1.0",
  "info": {
    "title": "validonce Fastify example",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "Signup": {
        "type": "object",
        "required": [
          "plan",
          "email",
          "start",
          "quantity"
        ],
        "properties": {
          "plan": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "free"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "pro"
                ]
              }
            ]
          },
          "company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "email": {
            "minLength": 1,
            "type": "string"
          },
          "start": {
            "format": "date",
            "type": "string"
          },
          "end": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "quantity": {
            "type": "integer"
          }
        },
        "x-validonce": {
          "version": 1,
          "rules": [
            {
              "id": "Signup.required_when.company",
              "kind": "required_when",
              "field": "company",
              "when": {
                "eq": {
                  "field": "plan",
                  "value": "pro"
                }
              },
              "message": {
                "key": "rules.company_required"
              }
            },
            {
              "id": "Signup.compare.end",
              "kind": "compare",
              "left": {
                "field": "end"
              },
              "op": "ge",
              "right": {
                "field": "start"
              },
              "type": "date",
              "message": {
                "key": "rules.end_after_start"
              }
            },
            {
              "id": "Signup.compare.quantity",
              "kind": "compare",
              "left": {
                "field": "quantity"
              },
              "op": "ge",
              "right": {
                "value": 1
              },
              "type": "number",
              "message": {
                "key": "rules.quantity_min",
                "params": {
                  "min": 1
                }
              }
            }
          ]
        }
      },
      "Contact": {
        "type": "object",
        "required": [
          "country"
        ],
        "properties": {
          "email": {
            "anyOf": [
              {
                "format": "email",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "phone": {
            "anyOf": [
              {
                "pattern": "^\\+?[0-9 ()-]{7,20}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "street": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "postalCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "US"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "CA"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "GB"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "other"
                ]
              }
            ]
          },
          "availableFrom": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "availableTo": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "x-validonce": {
          "version": 1,
          "rules": [
            {
              "id": "Contact.at_least_one_of.email",
              "kind": "at_least_one_of",
              "fields": [
                "email",
                "phone"
              ],
              "message": {
                "key": "rules.contact_email_or_phone"
              }
            },
            {
              "id": "Contact.all_or_none.street",
              "kind": "all_or_none",
              "fields": [
                "street",
                "city",
                "postalCode"
              ],
              "message": {
                "key": "rules.address_all_or_none"
              }
            },
            {
              "id": "Contact.required_when.postalCode",
              "kind": "required_when",
              "field": "postalCode",
              "when": {
                "eq": {
                  "field": "country",
                  "value": "US"
                }
              },
              "message": {
                "key": "rules.postal_code_required_us"
              }
            },
            {
              "id": "Contact.compare.availableTo",
              "kind": "compare",
              "left": {
                "field": "availableTo"
              },
              "op": "ge",
              "right": {
                "field": "availableFrom"
              },
              "type": "date",
              "message": {
                "key": "rules.available_to_after_from"
              }
            }
          ]
        }
      }
    }
  },
  "paths": {
    "/signups": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Signup"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/contacts": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Contact"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    }
  }
}
