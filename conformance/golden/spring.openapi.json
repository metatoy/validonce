  "components": {
    "schemas": {
      "Signup": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "string",
            "enum": [
              "free",
              "pro"
            ]
          },
          "company": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": "string",
            "maxLength": 2147483647,
            "minLength": 1
          },
          "start": {
            "type": "string",
            "format": "date"
          },
          "end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "email",
          "plan",
          "quantity",
          "start"
        ],
        "x-validonce": {
          "version": 1,
          "rules": [
            {
              "id": "Signup.required_when.company",
              "kind": "required_when",
              "field": "company",
              "when": {
                "eq": {
                  "field": "plan",
                  "value": "pro"
                }
              },
              "message": {
                "key": "rules.company_required"
              }
            },
            {
              "id": "Signup.compare.end",
              "kind": "compare",
              "left": {
                "field": "end"
              },
              "op": "ge",
              "right": {
                "field": "start"
              },
              "type": "date",
              "message": {
                "key": "rules.end_after_start"
              }
            },
            {
              "id": "Signup.compare.quantity",
              "kind": "compare",
              "left": {
                "field": "quantity"
              },
              "op": "ge",
              "right": {
                "value": 1
              },
              "type": "number",
              "message": {
                "key": "rules.quantity_min",
                "params": {
                  "min": 1
                }
              }
            }
          ]
        }
      },
      "Contact": {
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ],
            "format": "email"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\+?[0-9 ()-]{7,20}$"
          },
          "street": {
            "type": [
              "string",
              "null"
            ]
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "postalCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "type": "string",
            "pattern": "US|CA|GB|other"
          },
          "availableFrom": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "availableTo": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        },
        "required": [
          "country"
        ],
        "x-validonce": {
          "version": 1,
          "rules": [
            {
              "id": "Contact.at_least_one_of.email",
              "kind": "at_least_one_of",
              "fields": [
                "email",
                "phone"
              ],
              "message": {
                "key": "rules.contact_email_or_phone"
              }
            },
            {
              "id": "Contact.all_or_none.street",
              "kind": "all_or_none",
              "fields": [
                "street",
                "city",
                "postalCode"
              ],
              "message": {
                "key": "rules.address_all_or_none"
              }
            },
            {
              "id": "Contact.required_when.postalCode",
              "kind": "required_when",
              "field": "postalCode",
              "when": {
                "eq": {
                  "field": "country",
                  "value": "US"
                }
              },
              "message": {
                "key": "rules.postal_code_required_us"
              }
            },
            {
              "id": "Contact.compare.availableTo",
              "kind": "compare",
              "left": {
                "field": "availableTo"
              },
              "op": "ge",
              "right": {
                "field": "availableFrom"
              },
              "type": "date",
              "message": {
                "key": "rules.available_to_after_from"
              }
            }
          ]
        }
      }
    }
  }
