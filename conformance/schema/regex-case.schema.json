{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metatoy/validonce/conformance/schema/regex-case.schema.json",
  "title": "validonce regex oracle fixture",
  "type": "object",
  "required": ["version", "topic", "cases"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "topic": { "type": "string", "minLength": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "result": { "enum": ["match", "no-match", "error"] },
    "expect": {
      "type": "object",
      "required": ["js", "js-u", "python-re", "rust-regex", "dotnet"],
      "additionalProperties": false,
      "properties": {
        "js": { "$ref": "#/$defs/result" },
        "js-u": { "$ref": "#/$defs/result" },
        "python-re": { "$ref": "#/$defs/result" },
        "rust-regex": { "$ref": "#/$defs/result" },
        "dotnet": { "$ref": "#/$defs/result" }
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "finding", "description", "pattern", "inputs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^rx-[0-9]{3,}$" },
        "finding": { "type": "string", "pattern": "^VR[0-9]{3,}$" },
        "description": { "type": "string" },
        "pattern": { "type": "string" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["text", "expect"],
            "additionalProperties": false,
            "properties": { "text": { "type": "string" }, "expect": { "$ref": "#/$defs/expect" } }
          }
        }
      }
    }
  }
}
