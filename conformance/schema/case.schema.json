{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metatoy/validonce/conformance/schema/case.schema.json",
  "title": "validonce conformance case file",
  "type": "object",
  "required": ["version", "suite", "cases"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "suite": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "rules", "data", "expect"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+-[0-9]{3}$" },
          "description": { "type": "string", "minLength": 1 },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "rule-format-v1.schema.json#/$defs/rule" }
          },
          "data": { "type": "object" },
          "expect": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "ruleId", "key", "params"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "ruleId": { "type": "string" },
                "key": { "type": "string" },
                "params": { "type": "object" }
              }
            }
          }
        }
      }
    }
  }
}
