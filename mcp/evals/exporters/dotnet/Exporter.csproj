<Project Sdk="Microsoft.NET.Sdk">
  <!-- Eval helper: loads a migrated validator's dll and prints its exported validonce rules as JSON. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Exporter</AssemblyName>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../dotnet/src/Validonce.FluentValidation/Validonce.FluentValidation.csproj" />
  </ItemGroup>
</Project>
